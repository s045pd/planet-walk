{
  "name": "planet-walk",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "lint": "eslint src --ext .ts",
    "format": "prettier --write \"src/**/*.ts\"",
    "textures:download": "npx tsx scripts/download-textures.ts",
    "textures:compress": "npx tsx scripts/compress-textures.ts",
    "deploy": "npm run build && npx gh-pages -d dist -b gh-pages -m \"deploy: manual\""
  },
  "devDependencies": {
    "@types/three": "^0.183.1",
    "gh-pages": "^6.3.0",
    "tsx": "^4.22.4",
    "typescript": "^5.9.3",
    "vite": "^8.0.16"
  },
  "dependencies": {
    "three": "^0.183.1",
    "zustand": "^5.0.11"
  }
}
